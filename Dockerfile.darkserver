FROM ubuntu:24.04

RUN apt-get update && apt-get install -y \
    curl git bash ca-certificates gnupg ripgrep ffmpeg tini rclone \
    libvulkan-dev glslang-tools \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# uv installs Python 3.11 itself — no apt python needed
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

ENV PATH="/root/.cargo/bin:/root/.local/bin:$PATH"
ENV QMD_DATA_DIR="/root/.hermes/qmd"
# Keep the browser payload in the immutable image, outside the /root/.hermes
# volume overlay.  darkserver-start.sh discovers the executable at runtime
# and exports AGENT_BROWSER_EXECUTABLE_PATH for agent-browser.
ENV PLAYWRIGHT_BROWSERS_PATH="/opt/hermes/.playwright"

WORKDIR /app
COPY . /app

# Install Hermes' browser CLI and its Chromium shell into the image.  The
# runtime starts without a display, so the headless shell is sufficient and
# avoids downloading the full browser bundle.  Pinning comes from the checked
# in package-lock.json; do not use a floating global agent-browser install.
RUN npm install --workspaces=false --no-audit --fetch-retries=5 \
    && npm install --no-save --no-audit --fetch-retries=5 playwright@1.58.2 \
    && ./node_modules/.bin/playwright install --with-deps chromium --only-shell \
    && npm cache clean --force

RUN npm install -g @tobilu/qmd \
    && node - <<'EOF'
const fs = require('fs');
const path = require('path');
const cp = require('child_process');
const root = cp.execSync('npm root -g', { encoding: 'utf8' }).trim();
const f = path.join(root, '@tobilu/qmd', 'dist', 'llm.js');
if (!fs.existsSync(f)) {
  console.error(`QMD patch failed: ${f} not found`);
  process.exit(1);
}
const src = fs.readFileSync(f, 'utf8');
let patched = src;

const legacyTarget = /const loadLlama = async \(gpu\) => await getLlama\(\{\n\s*build: "autoAttempt",\n\s*logLevel: LlamaLogLevel\.error,\n\s*gpu,\n\s*\}\);/;
const currentTarget = /const loadLlama = async \(gpu, sourceBuildAllowed = ([^,]+), buildOverride\) => await withNativeStdoutRedirectedToStderr\(\(\) => getLlama\(\{\n[\s\S]*?^\s*skipDownload: !sourceBuildAllowed,\n\s*\}\)\);/m;

if (legacyTarget.test(src)) {
  patched = src.replace(
    legacyTarget,
    `const loadLlama = async (gpu) => await getLlama({\n                build: "never",\n                logLevel: LlamaLogLevel.error,\n                gpu: false,\n            });`
  );
} else if (currentTarget.test(src)) {
  patched = src.replace(
    currentTarget,
    (_match, defaultExpr) => `const loadLlama = async (gpu, sourceBuildAllowed = ${defaultExpr}, buildOverride) => await withNativeStdoutRedirectedToStderr(() => getLlama({\n                build: "never",\n                logLevel: LlamaLogLevel.error,\n                gpu: false,\n                progressLogs: false,\n                skipDownload: true,\n            }));`
  );
}

if (patched === src) {
  if (src.includes('build: "never"') && src.includes('gpu: false')) {
    console.log(`QMD llm.js already patched at ${f}.`);
    process.exit(0);
  }
  console.error('QMD patch failed: no known getLlama stanza matched');
  process.exit(1);
}

fs.writeFileSync(f, patched);
console.log(`QMD llm.js patched for CPU prebuilt mode at ${f}.`);
EOF

RUN uv venv venv --python 3.11 \
    && export VIRTUAL_ENV=/app/venv \
    && uv pip install -e ".[all]" \
    && uv pip install google-api-python-client google-auth-oauthlib google-auth-httplib2 garminconnect \
    && if [ -f "./tinker-atropos/pyproject.toml" ]; then uv pip install -e "./tinker-atropos"; fi

RUN mkdir -p /root/.local/bin \
    && ln -sf /app/venv/bin/hermes /root/.local/bin/hermes \
    && install -m 0755 /app/scripts/darkserver-start.sh /root/.local/bin/darkserver-start.sh \
    && if [ -f /app/scripts/obsidian-sync.sh ]; then install -m 0755 /app/scripts/obsidian-sync.sh /root/.local/bin/obsidian-sync.sh; fi

RUN mkdir -p /root/.hermes/{cron,sessions,logs,memories,skills,pairing,hooks,image_cache,audio_cache,whatsapp/session,qmd} \
    && cp /app/cli-config.yaml.example /root/.hermes/config.yaml

VOLUME ["/root/.hermes"]
EXPOSE 6666
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["darkserver-start.sh"]
